        "```html\n<!DOCTYPE html>\n<html lang=\"de\">\n  <head>\n    <meta charset=\"utf-8\">\n    <title>Speisekarte – Café Pause</title>\n  </head>\n  <body>\n    <h1>Speisekarte</h1>\n    <p><a href=\"index.html\">Zurück zur Startseite</a></p>\n\n    <h2>Getränke</h2>\n    <table>\n      <tr>\n        <th>Getränk</th>\n        <th>Größe</th>\n        <th>Preis</th>\n      </tr>\n      <tr>\n        <td>Kakao</td>\n        <td>0,3 l</td>\n        <td>1,50 €</td>\n      </tr>\n      <tr>\n        <td>Tee</td>\n        <td>0,3 l</td>\n        <td>1,00 €</td>\n      </tr>\n      <tr>\n        <td>Apfelschorle</td>\n        <td>0,5 l</td>\n        <td>1,80 €</td>\n      </tr>\n    </table>\n\n    <h2>Snacks</h2>\n    <table>\n      <tr>\n        <th>Snack</th>\n        <th>Preis</th>\n      </tr>\n      <tr>\n        <td>Brezel</td>\n        <td>1,00 €</td>\n      </tr>\n      <tr>\n        <td>Muffin</td>\n        <td>1,50 €</td>\n      </tr>\n    </table>\n    <img src=\"cafe-kuchen.svg\" alt=\"Ein Stück Kuchen mit Kirsche\">\n\n    <h2>Angebot der Woche</h2>\n    <table>\n      <tr>\n        <th colspan=\"2\">Kombi-Angebot</th>\n      </tr>\n      <tr>\n        <td>Kakao + Muffin</td>\n        <td>2,50 €</td>\n      </tr>\n    </table>\n  </body>\n</html>\n```"
      ],
      "solution": {
        "html": "<!DOCTYPE html>\n<html lang=\"de\">\n  <head>\n    <meta charset=\"utf-8\">\n    <title>Speisekarte – Café Pause</title>\n  </head>\n  <body>\n    <h1>Speisekarte</h1>\n    <p><a href=\"index.html\">Zurück zur Startseite</a></p>\n\n    <h2>Getränke</h2>\n    <table>\n      <tr>\n        <th>Getränk</th>\n        <th>Größe</th>\n        <th>Preis</th>\n      </tr>\n      <tr>\n        <td>Kakao</td>\n        <td>0,3 l</td>\n        <td>1,50 €</td>\n      </tr>\n      <tr>\n        <td>Tee</td>\n        <td>0,3 l</td>\n        <td>1,00 €</td>\n      </tr>\n      <tr>\n        <td>Apfelschorle</td>\n        <td>0,5 l</td>\n        <td>1,80 €</td>\n      </tr>\n    </table>\n\n    <h2>Snacks</h2>\n    <table>\n      <tr>\n        <th>Snack</th>\n        <th>Preis</th>\n      </tr>\n      <tr>\n        <td>Brezel</td>\n        <td>1,00 €</td>\n      </tr>\n      <tr>\n        <td>Muffin</td>\n        <td>1,50 €</td>\n      </tr>\n    </table>\n    <img src=\"cafe-kuchen.svg\" alt=\"Ein Stück Kuchen mit Kirsche\">\n\n    <h2>Angebot der Woche</h2>\n    <table>\n      <tr>\n        <th colspan=\"2\">Kombi-Angebot</th>\n      </tr>\n      <tr>\n        <td>Kakao + Muffin</td>\n        <td>2,50 €</td>\n      </tr>\n    </table>\n  </body>\n</html>\n"
      },
      "tests": [
        { "type": "text", "selector": "h2:last-of-type", "expected": "Angebot der Woche", "label": "Die letzte Überschrift zweiter Stufe lautet „Angebot der Woche“" },
        { "type": "selector", "selector": "table", "count": 3, "label": "Es gibt jetzt drei Tabellen" },
        { "type": "attr", "selector": "table:nth-of-type(3) th", "attr": "colspan", "expected": "2", "label": "Die Kopfzelle der Angebots-Tabelle reicht über zwei Spalten" },
        { "type": "text", "selector": "table:nth-of-type(3) th", "expected": "Kombi-Angebot", "label": "Die Kopfzelle lautet „Kombi-Angebot“" },
        { "type": "text", "selector": "table:nth-of-type(3) tr:nth-child(2) td:first-child", "expected": "Kakao + Muffin", "label": "Die Datenzeile beginnt mit „Kakao + Muffin“" },
        { "type": "text", "selector": "table:nth-of-type(3) tr:nth-child(2) td:nth-child(2)", "expected": "2,50 €", "label": "Das Kombi-Angebot kostet „2,50 €“" },
        { "type": "attr", "selector": "img[src='cafe-kuchen.svg']", "attr": "alt", "expected": "Ein Stück Kuchen mit Kirsche", "label": "Kontrolle: Das Kuchen-Bild mit Beschreibung ist noch da" },
        { "type": "text", "selector": "table:first-of-type tr:nth-child(2) td", "expected": "Kakao", "label": "Kontrolle: Die Getränke-Tabelle ist noch da" },
        { "type": "text", "selector": "title", "expected": "Speisekarte – Café Pause", "label": "Kontrolle: Der Seitentitel ist unverändert" }
      ]
    }
  ]
