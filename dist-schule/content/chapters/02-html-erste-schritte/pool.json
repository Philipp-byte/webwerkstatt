  "fragen": [
    {
      "id": "02-01",
      "konzept": "html.tag",
      "type": "quiz",
      "question": "Was ist bei `<p>Bis morgen!</p>` der Inhalt des Elements?",
      "options": [
        "Bis morgen!",
        "`<p>`",
        "`</p>`"
      ],
      "correct": 0,
      "explanation": "Der Inhalt steht zwischen öffnendem und schließendem Tag – nur ihn zeigt der Browser an."
    },
    {
      "id": "02-02",
      "konzept": "html.tag",
      "type": "fill",
